<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TransitionsAppUI.QuickLinkWindow"
        Title="Quick Link"
        Width="340" Height="240"
        MinWidth="300" MinHeight="200"
        CanResize="True"
        Topmost="True"
        Background="#0f1220"
        Padding="14">

  <Window.Resources>
    <SolidColorBrush x:Key="Card"     Color="#1a2140"/>
    <SolidColorBrush x:Key="Border"   Color="#2a3456"/>
    <SolidColorBrush x:Key="Text"     Color="#e9ecfa"/>
    <SolidColorBrush x:Key="TextDim"  Color="#b3bdd6"/>
    <SolidColorBrush x:Key="Accent"   Color="#7aa2f7"/>
    <SolidColorBrush x:Key="Success"  Color="#5fc39a"/>
    <SolidColorBrush x:Key="Danger"   Color="#e06c75"/>
    <SolidColorBrush x:Key="InputBg"  Color="#111730"/>
    <Thickness    x:Key="Pad">10</Thickness>
    <CornerRadius x:Key="Radius">8</CornerRadius>
  </Window.Resources>

  <Window.Styles>
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Margin" Value="0,0,0,3"/>
    </Style>
    <Style Selector="TextBox, ComboBox">
      <Setter Property="Background" Value="{StaticResource InputBg}"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="{StaticResource Radius}"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="Button">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Background" Value="#20284a"/>
      <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="{StaticResource Radius}"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="Button.accent">
      <Setter Property="Background" Value="{StaticResource Accent}"/>
      <Setter Property="Foreground" Value="#0b1022"/>
      <Setter Property="BorderBrush" Value="#5f86db"/>
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="{StaticResource Danger}"/>
      <Setter Property="Foreground" Value="#0b1022"/>
    </Style>
  </Window.Styles>

  <StackPanel Spacing="10">

    <!-- Header -->
    <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBlock Text="🔗 Quick Link" FontSize="14" FontWeight="Bold"/>
      <TextBlock Text="stays on top of Rekordbox" Classes="label" VerticalAlignment="Center"/>
    </StackPanel>

    <!-- From Song -->
    <StackPanel Spacing="3">
      <TextBlock Text="FROM SONG" Classes="label"/>
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
        <TextBox Name="QLFromSearchBox" Watermark="Search..." Grid.Column="0"/>
        <Button Name="QLSwapButton" Content="⇅" Grid.Column="1" ToolTip.Tip="Swap from/to"/>
      </Grid>
      <ComboBox Name="QLFromComboBox" HorizontalAlignment="Stretch"/>
    </StackPanel>

    <!-- To Song -->
    <StackPanel Spacing="3">
      <TextBlock Text="TO SONG" Classes="label"/>
      <TextBox Name="QLToSearchBox" Watermark="Search..."/>
      <ComboBox Name="QLToComboBox" HorizontalAlignment="Stretch"/>
    </StackPanel>

    <!-- Actions -->
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <TextBlock Name="QLStatusLabel" Text="" Classes="label" VerticalAlignment="Center" Grid.Column="0"/>
      <StackPanel Orientation="Horizontal" Spacing="6" Grid.Column="1">
        <Button Name="QLLinkButton" Content="Link ↵" Classes="accent"/>
        <Button Name="QLClearButton" Content="Clear" Classes="danger"/>
      </StackPanel>
    </Grid>

  </StackPanel>
</Window>
